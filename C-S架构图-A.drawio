          </mxGeometry>
        </mxCell>

        <!-- ContentArea 属于 StudentMainWindow 的子组件 -->
        <mxCell id="edge_c2_c2c" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1976D2;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="660" as="sourcePoint" />
            <mxPoint x="210" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ContentArea → VideoCard (我的收藏/最近播放中使用VideoCard) -->
        <mxCell id="edge_c2c_c4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D81B60;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
