          </mxGeometry>
        </mxCell>

        <!-- 服务端内部连线 -->
        <mxCell id="edge_s0_s1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A7C59;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1435" y="430" as="sourcePoint" />
            <mxPoint x="1435" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_s1_s2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A7C59;strokeWidth=1.5;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1370" y="810" as="sourcePoint" />
            <mxPoint x="1430" y="850" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_s1_s3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A7C59;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1435" y="810" as="sourcePoint" />
            <mxPoint x="1430" y="1050" as="targetPoint" />
