          </mxGeometry>
        </mxCell>

        <mxCell id="edge_c1_c2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B8FF9;strokeWidth=1.5;exitX=0.2;exitY=1;entryX=0.2;entryY=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="490" as="sourcePoint" />
            <mxPoint x="120" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_c1_c3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B8FF9;strokeWidth=1.5;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="490" as="sourcePoint" />
