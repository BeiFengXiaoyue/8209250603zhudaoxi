        <!-- 客户端 → 服务端 HTTP 连线 -->
        <mxCell id="edge_c_s" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9C27B0;strokeWidth=2;dashed=0;endArrow=classic;endFill=1;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="650" as="sourcePoint" />
